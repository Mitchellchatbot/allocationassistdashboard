# meta.scaledai.org
#
# Serves the dashboard (the built Vite app in /srv), and forwards Scaled
# Admissions' center onboarding form to that app, so the link we send a new
# center reads meta.scaledai.org/get-started/<token>. The form and its
# answers live in Scaled Admissions; nothing about them is stored here.
#
# The forwarded paths are the form page plus what it loads: Next's scripts,
# styles and fonts (/_next) and the two logo images. None of them exist in
# the dashboard's own build.

{
	admin off
	auto_https off
}

:{$PORT:3000} {
	encode zstd gzip

	@admissions path /get-started /get-started/* /_next/* /scaled-logo-white.png /scaled-mark-white.png
	handle @admissions {
		reverse_proxy {$ADMISSIONS_UPSTREAM:https://scaled-admissions-production.up.railway.app} {
			# Railway routes by Host, so send the app's own; the public host
			# still reaches it in X-Forwarded-Host.
			header_up Host {upstream_hostport}
		}
	}

	# The dashboard: real files first, then index.html so React Router can
	# handle deep links (what `serve -s` did before).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
